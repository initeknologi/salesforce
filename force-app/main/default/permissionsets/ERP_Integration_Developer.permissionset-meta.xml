    <fieldPermissions>
        <editable>true</editable>
        <field>Sales_Order__c.Last_Sync_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Sales_Order__c.Sync_Error_Message__c</field>
